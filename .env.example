# ==========================================
# 湖滨四季自动化选股系统 环境变量配置范例
# 使用时请复制此文件重命名为 .env，并填入您的 API 密钥
# ==========================================

# --- Notion API 配置 ---
# Notion Integration Token (格式为 ntn_...)
NOTION_TOKEN=your_notion_token_here
# Notion Database ID (32位字符)
NOTION_DATABASE_ID=your_database_id_here

# --- 大模型 API 配置 (支持云端 OpenAI 兼容接口 / 本地 Ollama) ---
# 云端 API 基础地址。如使用 Gemini，可配置为 Gemini 兼容的 API base；如使用 OpenAI 或 DeepSeek，按需填写。
# 本地 Ollama 默认为 http://localhost:11434/v1
LLM_API_BASE=https://api.openai.com/v1
# 您的 API Key。如果使用本地 Ollama，此处可随便填写或留空。
LLM_API_KEY=sk-your_api_key_here
# 模型名称。如: gpt-4o, deepseek-chat, gemini-1.5-pro, llama3, deepseek-r1 等
LLM_MODEL=gpt-4o

# --- 数据采集过滤参数 (可选配置) ---
# 个股流通市值上限（单位：元），默认 200 亿 (20000000000)
MAX_MARKET_CAP=20000000000
# 个股流通市值下限（单位：元），默认 10 亿 (1000000000)
MIN_MARKET_CAP=1000000000
# 龙虎榜最低机构净买入金额（单位：元），默认 1000 万 (10000000)
MIN_LHB_NET_BUY=10000000
